        }

        .footer-inner {
            border-top: 1px solid #d9d9d9;
            padding-top: 1rem;
            padding-bottom: 1rem
        }

        .clearfix::after {
            display: table;
            clear: both;
            content: ""
        }

        .clearfix .column {
            float: left;
            padding-right: 1.5rem;
            width: 50%
